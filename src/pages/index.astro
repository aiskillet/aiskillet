---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { CATEGORIES } from "../lib/taxonomy";

const entries = await getCollection("entries");
const total = entries.length;
---

<Base>
  <section class="hero">
    <div class="wrap">
      <span class="hero-badge"><span class="dot"></span>{total} skills · open source &amp; community-driven</span>
      <h1>Cook up your <span class="accent">agents</span>.</h1>
      <p>
        Discover and install AI skills, plugins, agents, and MCP servers — into
        Claude Code, Cursor, and the tools you already use. One command, straight from the source.
      </p>
    </div>
  </section>

  <section class="wrap" id="catalog">
    <div class="controls">
      <input
        id="search"
        class="search"
        type="search"
        placeholder="Search skills, plugins, agents…"
        autocomplete="off"
        aria-label="Search the catalog"
      />
      <select id="sort" class="sort" aria-label="Sort listings">
        <option value="trending">Trending</option>
        <option value="new">Newest</option>
        <option value="name">Name A–Z</option>
      </select>
    </div>

    <div class="facets">
      <div class="facet-row">
        <span class="facet-label">Type</span>
        <div id="type-facets" class="facet-chips"></div>
      </div>
      <div class="facet-row">
        <span class="facet-label">Category</span>
        <div id="category-facets" class="facet-chips"></div>
      </div>
      <div class="facet-row">
        <span class="facet-label">Tags</span>
        <div id="tag-facets" class="tagcloud"></div>
      </div>
    </div>

    <p class="count"><span id="count">{total}</span> results</p>

    <div class="grid" id="grid"></div>
    <div class="load-more-wrap"><button id="load-more" class="load-more">Show more</button></div>
    <p class="empty" id="empty">No results match your filters.</p>

    <noscript>
      <p class="count">Browse by category:</p>
      <div class="facet-chips" style="justify-content:center">
        {CATEGORIES.map((c) => (
          <a class="chip" href={`/category/${c.slug}`}>{c.label}</a>
        ))}
      </div>
    </noscript>
  </section>
</Base>

<script>
  import Fuse from "fuse.js";
  import { CATEGORIES, TYPES, TYPE_LABELS, categoryLabel } from "../lib/taxonomy";

  type Entry = {
    name: string; type: string; category: string; title: string;
    description: string; tags?: string[]; verified?: boolean;
    installs?: number; createdAt?: string;
  };

  const PAGE = 48;
  const state = {
    q: "", type: "all", category: "all",
    tags: new Set<string>(), sort: "trending", page: 1,
  };

  let entries: Entry[] = [];
  let fuse: Fuse<Entry>;

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

  init();

  async function init() {
    const res = await fetch("/index.json");
    const data = await res.json();
    entries = (data.entries ?? data) as Entry[];
    fuse = new Fuse(entries, {
      keys: ["title", "name", "description", "tags", "category"],
      threshold: 0.34,
      ignoreLocation: true,
    });
    wire();
    render();
  }

  function baseMatch(e: Entry, skip: { type?: boolean; cat?: boolean; tags?: boolean } = {}) {
    if (!skip.type && state.type !== "all" && e.type !== state.type) return false;
    if (!skip.cat && state.category !== "all" && e.category !== state.category) return false;
    if (!skip.tags && state.tags.size) {
      for (const t of state.tags) if (!(e.tags ?? []).includes(t)) return false;
    }
    return true;
  }

  function searched(): Entry[] {
    const q = state.q.trim();
    return q ? fuse.search(q).map((r) => r.item) : entries;
  }

  function filtered(): Entry[] {
    const list = searched().filter((e) => baseMatch(e));
    if (!state.q.trim()) {
      if (state.sort === "new") list.sort((a, b) => (b.createdAt ?? "").localeCompare(a.createdAt ?? ""));
      else if (state.sort === "name") list.sort((a, b) => a.title.localeCompare(b.title));
      else list.sort((a, b) => (b.installs ?? 0) - (a.installs ?? 0) || a.title.localeCompare(b.title));
    }
    return list;
  }

  function chip(val: string, label: string, count: number, active: boolean, group: string) {
    return `<button class="chip" data-group="${group}" data-val="${esc(val)}" aria-pressed="${active}">${esc(label)} <span class="n">${count}</span></button>`;
  }

  function renderFacets() {
    const s = searched();
    const typeSet = s.filter((e) => baseMatch(e, { type: true }));
    $("type-facets").innerHTML =
      chip("all", "All", typeSet.length, state.type === "all", "type") +
      TYPES.map((t) => chip(t, TYPE_LABELS[t], typeSet.filter((e) => e.type === t).length, state.type === t, "type")).join("");

    const catSet = s.filter((e) => baseMatch(e, { cat: true }));
    $("category-facets").innerHTML =
      chip("all", "All", catSet.length, state.category === "all", "category") +
      CATEGORIES.map((c) => chip(c.slug, c.label, catSet.filter((e) => e.category === c.slug).length, state.category === c.slug, "category")).join("");

    const tagSet = s.filter((e) => baseMatch(e, { tags: true }));
    const counts = new Map<string, number>();
    for (const e of tagSet) for (const t of e.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
    const top = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 24);
    for (const t of state.tags) if (!top.find((x) => x[0] === t)) top.unshift([t, counts.get(t) ?? 0]);
    $("tag-facets").innerHTML = top
      .map(([t, n]) => `<button class="t tagchip${state.tags.has(t) ? " on" : ""}" data-tag="${esc(t)}">${esc(t)} <span class="n">${n}</span></button>`)
      .join("");
  }

  function card(e: Entry) {
    return `<a class="card" href="/${e.name}">
      <div class="card-top">
        <div class="badges"><span class="tag-type">${e.type}</span>${e.verified ? '<span class="verified">✓ Verified</span>' : ""}</div>
        ${e.category ? `<span class="card-cat">${esc(categoryLabel(e.category))}</span>` : ""}
      </div>
      <h3>${esc(e.title)}</h3>
      <p>${esc(e.description)}</p>
      ${e.tags && e.tags.length ? `<div class="tags">${e.tags.map((t) => `<span class="t">${esc(t)}</span>`).join("")}</div>` : ""}
    </a>`;
  }

  function render() {
    renderFacets();
    const list = filtered();
    $("count").textContent = String(list.length);
    const shown = list.slice(0, state.page * PAGE);
    $("grid").innerHTML = shown.map(card).join("");
    ($("empty") as HTMLElement).style.display = list.length ? "none" : "block";
    ($("load-more") as HTMLElement).style.display = shown.length < list.length ? "inline-flex" : "none";
  }

  function wire() {
    ($("search") as HTMLInputElement).addEventListener("input", (e) => {
      state.q = (e.target as HTMLInputElement).value; state.page = 1; render();
    });
    ($("sort") as HTMLSelectElement).addEventListener("change", (e) => {
      state.sort = (e.target as HTMLSelectElement).value; render();
    });
    $("load-more").addEventListener("click", () => { state.page++; render(); });

    document.querySelector(".facets")!.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest("button");
      if (!btn) return;
      if (btn.classList.contains("tagchip")) {
        const t = btn.dataset.tag!;
        state.tags.has(t) ? state.tags.delete(t) : state.tags.add(t);
      } else if (btn.dataset.group) {
        const g = btn.dataset.group, v = btn.dataset.val!;
        if (g === "type") state.type = v;
        else if (g === "category") state.category = v;
      } else return;
      state.page = 1; render();
    });
  }
</script>
