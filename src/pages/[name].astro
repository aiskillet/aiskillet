---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("entries");
  return entries.map((e) => ({
    params: { name: e.data.name },
    props: { entry: e.data },
  }));
}

const { entry } = Astro.props;
const author = entry.author.replace(/^github:/, "");
const sourceUrl = entry.path ? `${entry.repo}/tree/main/${entry.path}` : entry.repo;
---

<Base title={`${entry.title} — AISkillet`} description={entry.description}>
  <section class="detail wrap">
    <a class="back" href="/">← Back to catalog</a>

    <div class="badges" style="margin-top:14px">
      <span class="tag-type">{entry.type}</span>
      {entry.verified && <span class="verified">✓ Verified</span>}
    </div>

    <h1>{entry.title}</h1>
    <p class="lede">{entry.description}</p>

    <div class="install-box">
      <label>Install with the skillet CLI</label>
      <div class="target-tabs" id="tabs">
        <button data-t="claude-code" class="on">Claude Code</button>
        <button data-t="cursor">Cursor</button>
        <button data-t="agents-md">AGENTS.md</button>
      </div>
      <div class="install-cmd">
        <code id="install">npx @aiskillet/cli add {entry.name} --target claude-code</code>
        <button class="copy-btn" id="copy">Copy</button>
      </div>
      <p class="install-hint">
        Install once: <code>npm i -g @aiskillet/cli</code> — then it works in whatever tool you use.
        The same skill, compiled to each target's native format.
      </p>
    </div>

    <dl>
      <dt>Author</dt>
      <dd><a href={`https://github.com/${author}`} target="_blank" rel="noopener">@{author}</a></dd>
      <dt>Source</dt>
      <dd><a href={sourceUrl} target="_blank" rel="noopener">{sourceUrl.replace("https://github.com/", "")}</a></dd>
      <dt>Targets</dt>
      <dd>{entry.targets.join(", ")}</dd>
      <dt>License</dt>
      <dd>{entry.license}</dd>
      {entry.tags.length > 0 && (
        <>
          <dt>Tags</dt>
          <dd>{entry.tags.join(", ")}</dd>
        </>
      )}
    </dl>
  </section>
</Base>

<script define:vars={{ name: entry.name }}>
  const cmdFor = (t) => `npx @aiskillet/cli add ${name} --target ${t}`;
  const codeEl = document.getElementById("install");
  const tabs = document.getElementById("tabs");

  tabs?.addEventListener("click", (e) => {
    const b = e.target.closest("button");
    if (!b) return;
    [...tabs.children].forEach((c) => c.classList.toggle("on", c === b));
    codeEl.textContent = cmdFor(b.dataset.t);
  });

  const copy = document.getElementById("copy");
  copy?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(codeEl.textContent);
    const prev = copy.textContent;
    copy.textContent = "Copied!";
    setTimeout(() => (copy.textContent = prev), 1400);
  });
</script>
