---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryCard from "../../components/EntryCard.astro";

export async function getStaticPaths() {
  const all = await getCollection("entries");
  const tags = [...new Set(all.flatMap((e) => e.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: all.filter((e) => (e.data.tags ?? []).includes(tag)).map((e) => e.data),
    },
  }));
}

const { entries, tag } = Astro.props;
---

<Base
  title={`#${tag} — AISkillet`}
  description={`AI skills, plugins, agents & MCP servers tagged "${tag}" on AISkillet.`}
>
  <section class="browse wrap">
    <a class="back" href="/">← All listings</a>
    <h1>#{tag}</h1>
    <p class="lede">{entries.length} listing{entries.length === 1 ? "" : "s"} tagged {tag}.</p>

    <div class="grid">
      {entries.map((e) => <EntryCard entry={e} />)}
    </div>
  </section>
</Base>
